<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Databasium" %></title>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <%= stylesheet_link_tag "databasium", "data-turbo-track": Rails.env.production? ? "reload" : "" %>
    <%= javascript_importmap_tags "databasium/application" %>

  </head>
  <body class="overflow-x-hidden">
    <%= render Components::Databasium::Global::Header.new(title: content_for?(:title) ? yield(:title) : "Databasium") %>
    <%= render Components::Databasium::Global::Flash.new(success: flash[:success], error: flash[:error]) %>
    
    <%= yield %>
  </body>
</html>
