<turbo-frame id="main" class=" sm:pe-100 block">
  <% if @model %>
    <%= render Components::Databasium::IconNavigationPanel.new(icons_with_text: 
        [
          {icon: "plus-circle", text: "add record"},
          {icon: "funnel", text: "filter"},
        ], vertical: true) %>
    <%= render Components::Databasium::RecordsFilter.new(
      model: @model,
      turbo_frame: "records",
      columns_names_types: @columns_names_types,
      hidden: true) %>
    <%= render Components::Databasium::ModelForm.new(columns_names_types: @columns_names_types, model: @model) %>
  <% end %>
  <%= turbo_frame_tag "records", class: "overflow-auto block", src: records_records_path(table: params[:table], frame_id: "records") do %>
    loading...
  <% end %>
</turbo-frame>
