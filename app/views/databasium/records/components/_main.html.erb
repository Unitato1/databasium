<turbo-frame id="main" class=" sm:pe-100 block">
  <% if @model %>
    <%= render Components::Databasium::IconNavigationPanel.new(icons_with_text: 
        [
          {icon: "plus-circle", text: "add record"},
          {icon: "funnel", text: "filter"},
        ], vertical: true) %>
    <%= render "databasium/records/components/filter" %>
    <%= render "databasium/records/components/add_record_form" %>
  <% end %>
  <turbo-frame id="records" class="overflow-auto block">
    <%= render Components::Databasium::Records.new(records: @records, model: @model) %>
    <% if @pagy %>
      <div class="mt-4 flex justify-start">
        <%== @pagy.series_nav %>
      </div>
    <% end %>
  </turbo-frame>
</turbo-frame>