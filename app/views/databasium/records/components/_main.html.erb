<turbo-frame id="main" class=" sm:pe-100 block">
  <%= render "databasium/records/components/filter" %>

  <turbo-frame id="records" class="mt-4 overflow-auto block">

    <% if @records %>
      <table class="table-fixed border-2 border-gray-300 whitespace-nowrap">
        <thead>
          <tr class="border-2 border-gray-300">
            <% @model.columns.each do |column| %>
              <th class="py-2 border-2 border-gray-300"><%= column.name %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @records.each do |record| %>
            <tr class="border-2 border-gray-300">
              <% record.attributes.each do |_, value| %>
                <td class="px-30 py-2 border-2 border-gray-300"><%= value %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p>No records found</p>
    <% end %>
  </turbo-frame>
</turbo-frame>