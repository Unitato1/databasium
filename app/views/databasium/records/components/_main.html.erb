<turbo-frame id="main" class=" sm:pe-100 block">
  <% if @model %>

    <%= render Databasium::NavigationPanelComponent.new(navigation_elements: 
        [
          {icon: "plus-circle", text: "add record"},
          {icon: "funnel", text: "filter"},
        ], vertical: true) %>

      <%= render "databasium/records/components/filter" %>
  <% end %>
  <turbo-frame id="records" class="overflow-auto block">
    <% if @records&.any? %>
      <%= render "databasium/records/components/add_record_form" %>
      <table class="table-fixed border-2 border-gray-300 whitespace-nowrap min-w-max">
        <thead>
          <tr class="border-2 border-gray-300">
            <% @model.columns.each do |column| %>
              <th class="py-2 border-2 border-gray-300"><%= column.name %></th>
            <% end %>
          </tr>
        </thead>
        <tbody id="records_list">
          <% @records.each do |record| %>
            <tr class="border-2 border-gray-300 hover:bg-gray-100">
              <% record.attributes.each do |_, value| %>
                <td class="text-center w-55 max-w-55 py-2 border-2 border-gray-300 overflow-auto"><%= value %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <% if @error %>
        <div class="border-2 border-gray-500 text-center p-4 rounded-xl bg-red-100">
          <p class="text-red-500 text-2xl"><%= @error %></p>
        </div>
      <% else %>
          <p>No records found</p>
      <% end %>
    <% end %>
  </turbo-frame>
</turbo-frame>