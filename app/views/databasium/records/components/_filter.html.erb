<% if @model %>
  <%= tag.div id: "filters",
    data: { 
      controller: "filter",
      filter_columns_value: @columns_names_types.to_json
    } do %>
    
    <%= form_with(url: records_path, method: :get,
        class: "flex flex-col gap-2 w-fit", 
        data: {
          action: "change->search#update",
          filter_target: "form",
          turbo_frame: "records"
      },
      ) do |form| %>
      <%= hidden_field_tag :table, @model.name %>

      <div class="flex items-center gap-2">
        <%= form.select nil,
          @model.column_names,
          { prompt: "Select column" },
          {
            class: "px-4 py-2 rounded-md border-2 border-gray-300", 
            data: 
            { 
              filter_target: "selectColumn",
              action: "change->filter#chooseColumn focus->filter#rememberValue",
            }
          }
        %>
        <button data-action="click->filter#removeFilter" class="text-red-500 hover:text-red-800"> remove filter </button>
      </div>
      <%= form.submit "Filter", class: "border-2 border-gray-300" %>
   
    <% end %>
   
    <button type="button"
      data-action="click->filter#addFilter"
      class="mt-2 bg-blue-500 text-white px-3 py-1 rounded">
      + Add Filter
    </button>

  <% end %>
<% end %>