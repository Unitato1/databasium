<div class="absolute top-20 left-0 right-0 px-4 z-50 transition-opacity duration-1000 ease-in-out" data-controller="flash">
  <% if flash[:success] %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-xl shadow-md w-full max-w-4xl mx-auto relative" role="alert">
      <h2 class="font-bold border-b-1 border-b-gray-300">Success!</h2>
      <p class="block"><%= flash[:success] %></p>
      <button type="button" class="absolute right-4 top-1" data-action="click->flash#close">
        <%= heroicon "x-mark", variant: :solid, options: { class: "w-8 h-8 hover:cursor-pointer" } %>
      </button>
    </div>
  <% end %>
  <% if flash[:error] %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-xl shadow-md w-full max-w-4xl mx-auto" role="alert">
      <h2 class="font-bold">Error!</h2>
      <p class="block"><%= flash[:error] %></p>
    </div>
    <button type="button" class="absolute right-4 top-1" data-action="click->flash#close">
      <%= heroicon "x-mark", variant: :solid, options: { class: "w-8 h-8 hover:cursor-pointer" } %>
    </button>
  <% end %>
</div>
