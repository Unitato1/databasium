<turbo-frame id="migration_preview">
  <div class="bg-gray-100 p-4 rounded-2xl">
    <% if @content %>
      <h1 class="text-xl font-semibold mb-3">Preview Migration</h1>
      <pre><%= h @content %></pre>
    <% else %>
      <h1 class="text-xl font-semibold">Please fill out the form to see the preview</h1>
    <% end %>
  </div>
</turbo-frame>
