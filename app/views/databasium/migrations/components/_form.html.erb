<%= form_with(url: migrations_path, method: :post, id: "migration_form", class: "flex p-4 gap-4", data: { controller: "new-migration" }) do |form| %>
  <div class="flex flex-col gap-4 min-w-fit w-1/3 bg-gray-100 rounded-xl p-4 border-2 border-gray-300">
    <%= render Components::Databasium::Collapsable.new(name: "migration_action", form: form) do %>
      <%= form.select :migration_action, ["create", "remove", "add"], {}, class: "p-2 border-2 border-gray-300 rounded-md w-fit", data: { action: "change->new-migration#set_action" }  %>
      <div class="flex items-center gap-2 py-2" data-new-migration-target="add_model_container">
        <%= form.check_box :add_model, checked: true, class: "w-4 h-4", data: { new_migration_target: "add_model" } %>
        <%= form.label :add_model, "Add also model" %>
      </div>
      <div class="flex flex-col hidden" data-new-migration-target="table_name_from">
        <%= form.label :table_name_from, "Table to remove from" %>
        <%= form.select :table_name_from, @tables, { include_blank: "Select a table" }, class: "p-2 border-2 border-gray-300 rounded-md w-fit" %>
      </div>
      <div class="flex flex-col hidden" data-new-migration-target="table_name_to">
        <%= form.label :table_name_to, "Table to add to" %>
        <%= form.select :table_name_to, @tables, { include_blank: "Select a table" }, class: "p-2 border-2 border-gray-300 rounded-md w-fit" %>
      </div>
    <% end %>
    <%= render Components::Databasium::Collapsable.new(name: "table_name", form: form, data_targets: { new_migration_target: "table_name" }) do %>
      <%= form.text_field :table_name, class: "p-2 border-2 border-gray-300 w-fit" %>
    <% end %>
    <%= render Components::Databasium::Collapsable.new(name: "columns", form: form, class_name: "flex flex-col border-b border-gray-300 pb-4 gap-2") do %>
      <div data-new-migration-target="column" class="flex gap-2 items-end hidden">
        <div class="flex flex-col gap-2">
          <% if @model %>
            <%= form.select :column_name, @model.columns.map(&:name), { include_blank: "Select a column name" }, class: "p-2 border-2 border-gray-300 rounded-md w-fit" %>
          <% else %>
            <label for="column_name" class="text-sm font-semibold">Column Name</label>
            <input type="text" name="columns[][column_name]", class="p-1 border-2 rounded-xl border-gray-300 h-fit", data-action="change->new-migration#updateColumnNames"/>            
          <% end %>
        </div>
        <div class="flex flex-col gap-2 h-full">
          <label for="column_type" class="text-sm font-semibold">Column Type</label>
          <select name="columns[][column_type]", class="border-2 rounded-xl p-1 border-gray-300 h-full">
            <option value="text">      Text      </option>
            <option value="string">    String    </option>
            <option value="integer">   Integer   </option>
            <option value="float">     Float     </option>
            <option value="decimal">   Decimal   </option>
            <option value="time">      Time      </option>
            <option value="date">      Date      </option>
            <option value="datetime">  Datetime  </option>
            <option value="timestamp"> Timestamp </option>
            <option value="binary">    Binary    </option>
            <option value="boolean">   Boolean   </option>
            <option value="references"> Reference   </option>
          </select>
        </div>
        <button data-action="click->new-migration#removeColumn" type="button" class="text-red-500 border-2 border-red-500 rounded-xl h-fit">
          <%= heroicon "x-mark", variant: :solid, options: { class: "w-8 h-8" } %>
        </button>
      </div>
      <button data-action="click->new-migration#addColumn" type="button" class="text-blue-500">
        <%= heroicon "plus-circle", variant: :outline, options: { class: "w-8 h-8" } %>
      </button>
    <% end %>
    <%= render Components::Databasium::Collapsable.new(name: "Valiadtion", form: form, class_name: "flex flex-col border-b border-gray-300 pb-4 gap-2", data_targets: { new_migration_target: "validations" }) do %>
      <div data-new-migration-target="validation" class="flex gap-2 items-end hidden">
        <select name="validation[][column_name]", class="p-2 border-2 border-gray-300 w-fit" data-new-migration-target="validation_column_name">
          <option value="">Select column</option>
        </select>
        <%
=begin%>
        <%= form.select :validation_column_name, [], { include_blank: "Select column" }, data: { new_migration_target: "validation_column_name" }, class: "p-2 border-2 border-gray-300 w-fit" %>
        <%
=end%>
        <select name="validation[][type]", class="p-2 border-2 border-gray-300 w-fit" data-new-migration-target="validation_column_type">
          <option value="uniqueness">Uniqueness</option>
          <option value="not_null">Not Null</option>
        </select>
        <button data-action="click->new-migration#removeValidation" type="button" class="text-red-500 border-2 border-red-500 rounded-xl h-fit">
          <%= heroicon "x-mark", variant: :solid, options: { class: "w-8 h-8" } %>
        </button>
      </div>
      <button data-action="click->new-migration#addValidation" type="button" class="text-blue-500">
        <%= heroicon "plus-circle", variant: :outline, options: { class: "w-8 h-8" } %>
      </button>
    <% end %>
    <div>
      <%= form.submit "Generate Preview", class: "bg-blue-500 text-white p-2 rounded-md w-fit", name: "add_migration" %>
    </div>
  </div>
  <div class="flex-1 pe-4">
    <%= render "databasium/migrations/components/migration_preview", form: form %>
  </div>
<% end %>
