<%= form_with(url: migrations_path, method: :post, class: "flex flex-col gap-4 mx-auto w-fit", data: { controller: "new-migration" }) do |form| %>

  <div class="flex flex">
    <div class="flex flex-col">
      <%= form.label :migration_action %>
      <%= form.select :migration_action, ["create", "remove", "add"], {}, class: "p-2 border-2 border-gray-300 rounded-md w-fit", data: { action: "change->new-migration#set_action" }  %>
      <div class="flex flex-col" data-new-migration-target="add_model_container">
        <%= form.label :add_model, "Add also model" %>
        <%= form.check_box :add_model, checked: true, class: "p-2 border-2 border-gray-300 rounded-md w-fit", data: { new_migration_target: "add_model" } %>
      </div>
    </div>

    <div class="flex flex-col hidden" data-new-migration-target="table_name_from">
      <%= form.label :table_name_from, "Table to remove from" %>
      <%= form.select :table_name_from, @tables, { include_blank: "Select a table" }, class: "p-2 border-2 border-gray-300 rounded-md w-fit" %>
    </div>

    <div class="flex flex-col hidden" data-new-migration-target="table_name_to">
      <%= form.label :table_name_to, "Table to add to" %>
      <%= form.select :table_name_to, @tables, { include_blank: "Select a table" }, class: "p-2 border-2 border-gray-300 rounded-md w-fit" %>
    </div>
  </div>

  <div class="flex flex-col" data-new-migration-target="table_name">
    <%= form.label :table_name, class: "text-lg font-semibold" %>
    <%= form.text_field :table_name, class: "border-2 border-gray-300 w-fit" %>
  </div>

  <div class="flex flex-col">
    <h1 class="text-lg font-semibold">Primary Keys</h1>
    <%= form.label :primary_key %>
    <%= form.text_field :primary_key, class: "p-2 border-2 border-gray-300 w-fit" %>
  </div>

  <div class="flex flex-col">
    <h1 class="text-lg font-semibold">Columns</h1>
    <div data-new-migration-target="column" class="hidden flex gap-2">
      <label for="column_name" class="text-lg font-semibold">Column Name</label>
      <input type="text" name="columns[][column_name]", class="p-2 border-2 border-gray-300 w-fit"/>
      <label for="column_type" class="text-lg font-semibold">Column Type</label>
      <input type="text" name="columns[][column_type]", class="p-2 border-2 border-gray-300 w-fit"/>
      <button data-action="click->new-migration#removeColumn" type="button" class="bg-red-500 text-white p-1 rounded-md w-fit">-</button>
    </div>

