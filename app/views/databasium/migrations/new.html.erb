<%= form_with(url: migrations_path, method: :post, class: "flex flex-col gap-4 mx-auto w-fit") do |form| %>

  <div class="flex flex-col">
    <%= form.label :action %>
    <%= form.select :action, ["create", "remove", "add"], {}, class: "p-2 border-2 border-gray-300 rounded-md w-fit" %>
  </div>

  <div class="flex flex-col">
    <%= form.label :table_name, class: "text-lg font-semibold" %>
    <%= form.text_field :table_name, class: "border-2 border-gray-300 w-fit" %>
  </div>

  <div class="flex flex-col">
    <h1 class="text-lg font-semibold">Primary Keys</h1>
    <%= form.label :primary_key %>
    <%= form.text_field :primary_key, class: "p-2 border-2 border-gray-300 w-fit" %>
  </div>

  <div class="flex flex-col">
    <h1 class="text-lg font-semibold">Columns</h1>
    <label for="column_name" class="text-lg font-semibold">Column Name</label>
    <input type="text" name="columns[][column_name]", class="p-2 border-2 border-gray-300 w-fit"/>
    <label for="column_type" class="text-lg font-semibold">Column Type</label>
    <input type="text" name="columns[][column_type]", class="p-2 border-2 border-gray-300 w-fit"/>

    <label for="column_name" class="text-lg font-semibold">Column Name</label>
    <input type="text" name="columns[][column_name]", class="p-2 border-2 border-gray-300 w-fit"/>
    <label for="column_type" class="text-lg font-semibold">Column Type</label>
    <input type="text" name="columns[][column_type]", class="p-2 border-2 border-gray-300 w-fit"/>


    <button class="bg-blue-500 text-white p-1 rounded-md w-fit">+</button>
  </div>

  <div class="flex flex-col">
    <h1 class="text-lg font-semibold">Valiadtion</h1>
    <%= form.label :validation_column_name %>
    <%= form.select :validation_column_name, ["create", "remove", "add"], {}, class: "p-2 border-2 border-gray-300 w-fit" %>
    
    <%= form.label :validation_name_column %>
    <%= form.text_field :validation_name_column, class: "p-2 border-2 border-gray-300 w-fit" %>
  
    <button class="bg-blue-500 text-white p-1 rounded-md w-fit">+</button>
  </div>

  <div>
    <%= form.submit "Save", class: "bg-blue-500 text-white p-2 rounded-md w-fit" %>
  </div>
<% end %>


