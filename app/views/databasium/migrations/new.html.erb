  </div>

  <div class="flex flex-col">
    <h1 class="text-lg font-semibold">Valiadtion</h1>
    <%= form.label :validation_column_name %>
    <%= form.select :validation_column_name, ["create", "remove", "add"], {}, class: "p-2 border-2 border-gray-300 w-fit" %>
    
    <%= form.label :validation_name_column %>
    <%= form.text_field :validation_name_column, class: "p-2 border-2 border-gray-300 w-fit" %>
  
