<div data-controller="attribute">
  <%= render Components::Databasium::Collapsable.new(
    name: "Attribute",
    form: nil,
    name_params: { data: { attribute_target: "name" } }
  ) do %>
    <div class="flex flex-col gap-2 mb-2 group">
      <input 
        type="text" 
        name="model[attributes][][name]"
        data-action="input->attribute#updateName"
      data-attribute-target="nameInput"
      placeholder="Attribute Name (e.g. email)"
      class="border-2 rounded-xl p-1 border-gray-300 w-full mt-2" />
      <%= render Components::Databasium::TypeSelect.new(name: "model[attributes][][type]") %>
      <%= render Components::Databasium::Collapsable.new(name: "Validation", form: nil) do %>
        <div data-model-target="validationsContainer" class="validationsContainer">
          <div class="flex items-center gap-2">
            <span class="font-semibold">Add new Validation</span>
            <button data-action="click->model#add click->attribute#updateValidationName" data-model-target-param="validation" data-model-container-param="validationsContainer" type="button" class="text-blue-500">
              <%= heroicon "plus-circle", variant: :outline, options: { class: "w-8 h-8" } %>
            </button>
          </div>
        </div>
      <% end %>
      <%= render Components::Databasium::Collapsable.new(name: "Relation", form: nil) do %>
        <div data-model-target="relationsContainer" class="relationsContainer">
          <div class="flex items-center gap-2">
            <span class="font-semibold">Add new Relation</span>
            <button data-action="click->model#add" data-model-target-param="relation" data-model-container-param="relationsContainer" type="button" class="text-blue-500">
              <%= heroicon "plus-circle", variant: :outline, options: { class: "w-8 h-8" } %>
            </button>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
