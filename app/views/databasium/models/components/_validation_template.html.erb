<template data-model-target="validation">
  <div class="flex gap-2 mt-2">
    <input type="text" name="model[attributes][][validations][][name]" value="presence" class="hidden" />
    <input type="text" name="model[attributes][][validations][][type]" value="required" class="border-2 rounded-xl p-1 border-gray-300 w-fit mt-2" />
    <input type="text" name="model[attributes][][validations][][value]" value="true" class="border-2 rounded-xl p-1 border-gray-300 w-fit mt-2" />
  </div>
</template>