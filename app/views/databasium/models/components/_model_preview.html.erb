<div id="model_preview">
  <div class="bg-gray-100 border-2 border-gray-300 p-4 rounded-2xl min-h-full flex-1">
    <% if @content %>
      <h1 class="text-xl font-semibold mb-3 border-b border-gray-300 pb-3">Preview for Model</h1>
      <pre><%= h @content %></pre>
      <button 
        type="submit" 
        form="model_form"
        name="commit"
        value="Create model file"
        class="bg-blue-500 text-white p-2 rounded-md w-fit mt-4 hover:bg-blue-800"
      >
        Create model file
      </button>
    <% else %>
      <h1 class="text-xl font-semibold">Please fill out the form to see the preview</h1>
    <% end %>
  </div>
</div>