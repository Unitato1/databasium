<%
=begin%>
 <% @schema.each do |table, data| %>
 <%= table %>
  </br>
 <%= data.each do |key, value| %>
  key <%= key %>
  <% if key == :columns %>
    </br><% value.each do |column| %>
      <%= column[:name] %>
      <%= column[:sql_type] %>
      <%= column[:null] %>
      <%= column[:default] %>
      </br>
    <% end %>
    <% else %>
      <%= value %>
  <% end %>
  </br>
  <% end %> 
  </br>
  </br>
  </br>
<% end %> 
<%
=end%>
<div class="w-full h-full p-20">
  <%= tag.div id: "filters",
    class: "w-full h-full border-1 rounded-2xl p-4",
    data: { 
        controller: "graph",
        graph_tables_value: @schema.to_json
    } do %>
  <% end %>
</div>