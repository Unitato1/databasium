#!/usr/bin/env ruby
# frozen_string_literal: true

engine_root = File.expand_path("../../../..", __dir__)
gemfile = File.join(engine_root, "Gemfile")

tailwind_input  = File.join(engine_root, "app/assets/stylesheets/databasium/databasium_engine.css")
tailwind_output = File.join(engine_root, "app/assets/builds/databasium.css")
tailwind_config = File.join(engine_root, "config/tailwind.config.js")

env = { "BUNDLE_GEMFILE" => gemfile }

tailwind_pid = Process.spawn(env, "bundle", "exec", "tailwindcss",
  "-i", tailwind_input,
  "-o", tailwind_output,
  "-c", tailwind_config,
  "--minify", "-w",
  chdir: engine_root,
  out: $stdout, err: $stderr
)

at_exit do
  begin
    Process.kill("TERM", tailwind_pid) if tailwind_pid
    Process.wait(tailwind_pid) rescue nil
  rescue Errno::ESRCH, Errno::ECHILD
  end
end

trap("INT") { exit }
trap("TERM") { exit }

exec "./bin/rails", "server", *ARGV
